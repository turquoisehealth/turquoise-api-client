{
  "name": "turquoise-api-client-tests",
  "version": "1.0.0",
  "description": "Integration tests for Turquoise Health API TypeScript client",
  "scripts": {
    "test": "jest"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/*.test.ts"
    ],
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "globals": {
      "ts-jest": {
        "isolatedModules": true,
        "tsconfig": {
          "esModuleInterop": true,
          "lib": ["ES2020", "DOM"],
          "types": ["jest", "node"]
        }
      }
    }
  }
}
