{
  "name": "turquoise-api-client-tests",
  "version": "1.0.0",
  "description": "Unit and integration tests for Turquoise Health API TypeScript client",
  "scripts": {
    "test": "jest",
    "test:unit": "jest --runInBand --testPathIgnorePatterns=integration.test.ts --coverage",
    "test:integration": "jest --runInBand integration.test.ts"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "@types/node": "^20.19.43",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "jest": {
    "rootDir": "..",
    "preset": "./tests/node_modules/ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "<rootDir>/tests/**/*.test.ts"
    ],
    "collectCoverageFrom": [
      "lib/**/*.ts"
    ],
    "coverageDirectory": "<rootDir>/tests/coverage",
    "coverageThreshold": {
      "global": {
        "branches": 90,
        "functions": 90,
        "lines": 90,
        "statements": 90
      }
    },
    "moduleNameMapper": {
      "^(\\.{1,2}/.*)\\.js$": "$1"
    },
    "transform": {
      "^.+\\.tsx?$": [
        "<rootDir>/tests/node_modules/ts-jest",
        {
          "isolatedModules": true,
          "tsconfig": {
            "esModuleInterop": true,
            "lib": ["ES2020", "DOM"],
            "types": ["jest", "node"]
          }
        }
      ]
    }
  }
}
