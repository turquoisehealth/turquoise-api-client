{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "outDir": "./dist",
    "rootDir": "..",
    "isolatedModules": true,
    "types": ["jest", "node"]
  },
  "include": [
    "**/*.ts",
    "../**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
