<!--
Configure additional MSBuild properties for your project in this file:
- Step 1: Add this file to your .fernignore file to ensure it is not overwritten.
- Step 2: Modify this file to your liking.
-->
<Project>
  <PropertyGroup>
    <PackageId>TurquoiseHealth.Api</PackageId>
    <Title>Turquoise Health API Client</Title>
    <Authors>Turquoise Health</Authors>
    <Company>Turquoise Health</Company>
    <Description>Official C# SDK for Turquoise Health API</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/turquoisehealth/turquoise-api-client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/turquoisehealth/turquoise-api-client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>
</Project>
