# Fern ignore file - prevents Fern from deleting custom/manual code
# Add paths relative to the output directory that should not be deleted during generation

# Protect manually-coded library directories
src/TurquoiseHealth.Api/Lib/
src/TurquoiseHealth.Api/Lib/**
src/TurquoiseHealth.Api.Test/Unit/Lib/

# Protect custom MSBuild properties
src/TurquoiseHealth.Api/TurquoiseHealth.Api.Custom.props
src/TurquoiseHealth.Api.Test/TurquoiseHealth.Api.Test.Custom.props

# Protect README symlink
README.md

# Protect integration tests
tests/
tests/**

# Other
.github/
